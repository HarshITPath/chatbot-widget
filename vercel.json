{
  "version": 2,
  "name": "chatbot-widget",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "VITE_API_URL": "@vite_api_url",
      "VITE_PRIMARY_COLOR": "@vite_primary_color",
      "VITE_SECONDARY_COLOR": "@vite_secondary_color",
      "VITE_BOT_NAME": "@vite_bot_name",
      "VITE_BOT_AVATAR": "@vite_bot_avatar",
      "VITE_USER_AVATAR": "@vite_user_avatar",
      "VITE_GREETING": "@vite_greeting",
      "VITE_PLACEHOLDER": "@vite_placeholder",
      "VITE_POSITION": "@vite_position"
    }
  },
  "routes": [
    {
      "src": "/widget/(.*)",
      "dest": "/widget/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/(.*\\.(js|css|json|ico|png|jpg|jpeg|gif|svg))",
      "dest": "/$1",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
