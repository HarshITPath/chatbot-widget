# Environment Variables for Chatbot Widget
# Copy this file to .env.local and customize for your environment

# API Configuration
VITE_API_URL=http://localhost:3000/api

# Appearance
VITE_PRIMARY_COLOR=#1976d2
VITE_SECONDARY_COLOR=#dc004e

# Bot Configuration
VITE_BOT_NAME=Development Assistant
VITE_BOT_AVATAR=🤖
VITE_USER_AVATAR=👤

# UI Settings
VITE_POSITION=bottom-right
VITE_BUTTON_SIZE=64
VITE_BORDER_RADIUS=3
VITE_Z_INDEX=1300

# Content
VITE_GREETING=Hi! 👋 How can I help you today? (Development Mode)
VITE_PLACEHOLDER=Type your message...

# Styling
VITE_SHADOW=0 8px 32px rgba(0,0,0,0.12)
VITE_FONT_FAMILY="Urbanist", "Rubik", system-ui, -apple-system, sans-serif
